  "query": "SELECT\n                 c.capsule_id,\n                 c.app,\n                 c.environment,\n                 c.status,\n                 c.current_desired_fingerprint,\n                 c.backup_class,\n                 c.slo_class,\n                 cr.revision_number AS \"current_revision_number?\"\n             FROM capsule c\n             LEFT JOIN capsule_revision cr\n               ON cr.capsule_revision_id = c.current_revision_id\n             WHERE c.app = $1 AND c.environment = $2",
